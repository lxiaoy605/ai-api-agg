# =============================================
# 开发环境 — 本地 dev 模式专用
# 仅 NEXT_PUBLIC_* 变量可在浏览器端访问
# =============================================

# 后端 API 地址（开发走本地 nginx 代理）
NEXT_PUBLIC_API_URL=http://localhost:8080

# 站点元数据
NEXT_PUBLIC_SITE_NAME=AiFlowHub Dev
NEXT_PUBLIC_SITE_URL=http://localhost:80
