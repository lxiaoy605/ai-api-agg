# OneAPI 环境变量模板
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=3000

# 数据库（SQLite 文件路径，Docker 内挂载到 /data/）
SQL_DSN=one-api.db

# 管理员初始账号
INITIAL_ROOT_TOKEN=123456

# 会话密钥（生产环境需更换为随机字符串）
SESSION_SECRET=change-me-in-production-32chars-min

# 日志级别: debug / info / warn / error
LOG_LEVEL=info

# SQLite 相关
SQLITE_BUSY_TIMEOUT=3000

# Redis（可选，分布式部署时启用）
# REDIS_URL=redis://redis:6379
