# =============================================
# AI API 聚合平台 — 环境变量模板
# =============================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# =============================================

# ==========================================
# 域名与 SSL（Nginx + Certbot）
# ==========================================
# 生产域名（必填，用于 SSL 证书签发和 Nginx 配置）
DOMAIN_NAME=aiflowhub.ai

# 健康检查外部域名（healthcheck.sh 外部探测使用）
ONEAPI_DOMAIN=aiflowhub.ai

# Let's Encrypt 通知邮箱（必填，用于证书到期提醒）
SSL_EMAIL=your-email@example.com

# SSL 测试模式（1=使用 Let's Encrypt staging 环境，避免频率限制）
SSL_STAGING=0

# Nginx 容器名（与 docker-compose 中 container_name 一致）
NGINX_CONTAINER=ai-api-agg-nginx

# Certbot HTTP-01 验证目录（与 nginx http.conf 中 root 路径一致）
CERTBOT_WWW=/var/www/certbot

# ==========================================
# Stripe 支付
# ==========================================
# Stripe Secret Key（从 Stripe Dashboard 获取）
STRIPE_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxx

# Stripe Webhook Secret（用于验证 Webhook 签名）
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Stripe Publishable Key（前端用）
NEXT_PUBLIC_STRIPE_PUBLISHABLE=pk_live_xxxxxxxxxxxxxxxxxxxx

# ==========================================
# NOWPayments 支付网关
# ==========================================
# NOWPayments API Key（从 https://nowpayments.io 控制台获取）
NOWPAYMENTS_API_KEY=
# NOWPayments IPN Secret（可选，用于回调验证）
NOWPAYMENTS_IPN_SECRET=
# NOWPayments API 基础 URL
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
# IPN 回调地址（NOWPayments 向此地址 POST 支付状态更新）
NOWPAYMENTS_IPN_URL=https://aiflowhub.ai/api/payment/webhook
# 支付成功/取消后跳转地址
NOWPAYMENTS_SUCCESS_URL=https://aiflowhub.ai/recharge/success
NOWPAYMENTS_CANCEL_URL=https://aiflowhub.ai/recharge

# ==========================================
# USDT TRC-20
# ==========================================
# 收款钱包地址
USDT_WALLET=TXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TronGrid API Key（用于监听链上交易）
TRONGRID_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ==========================================
# 模型厂商 API Key（渠道对接）
# ==========================================

# ==========================================
# OneAPI 管理
# ==========================================
# OneAPI 管理员 Token（在 OneAPI 面板 /user/token 获取）
ONEAPI_ADMIN_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OneAPI 内部地址（Docker 网络内）
ONEAPI_INTERNAL_URL=http://oneapi:3000

# ==========================================
# 后端服务
# ==========================================
# 后端容器内端口（不需要改）
BACKEND_PORT=8080
# 后端蓝绿实例外部端口（供直接访问和健康检查）
BACKEND_BLUE_PORT=8082
BACKEND_GREEN_PORT=8083

# JWT 密钥（生产环境请生成随机字符串：openssl rand -hex 32）
JWT_SECRET=change-me-to-random-64-chars

# 数据库文件路径
DB_PATH=/app/data/app.db

# 日志级别: debug / info / warn / error
LOG_LEVEL=info

# ==========================================
# 前端
# ==========================================
# Next.js 公共环境变量
NEXT_PUBLIC_API_URL=https://aiflowhub.ai
NEXT_PUBLIC_SITE_NAME=AI Flow Hub

# ==========================================
# ==========================================
# HAProxy 蓝绿部署
# ==========================================
# HAProxy 状态页管理员密码（默认: admin123，生产环境请修改）
HAPROXY_STATS_PASSWORD=admin123

# ==========================================
# Keepalived VIP 高可用（需要 2 台 VPS 时才启用）
# ==========================================
# 虚拟 IP 地址（两台 VPS 必须相同，格式: IP/前缀长度）
KEEPALIVED_VIP=10.0.0.100/24
# 角色: MASTER（主节点）| BACKUP（备节点），两台必须不同
KEEPALIVED_ROLE=MASTER
# 网卡接口（可选，留空自动检测默认路由接口）
KEEPALIVED_INTERFACE=

# ==========================================
# 部署环境
# ==========================================
# 环境标识: development / staging / production
ENVIRONMENT=production

# 时区
TZ=Asia/Shanghai

# ==========================================
# 厂商 API Key（用于余额监控 + OneAPI 渠道配置）
# ==========================================
# DeepSeek API Key — 从 platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DeepSeek API Key 2 — 备用 Key，用于多账号轮询
DEEPSEEK_API_KEY_2=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Z.ai（智谱国际站）API Key — 从 z.ai 控制台获取
ZHIPU_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 智谱渠道别名（healthcheck.sh / failover.sh / channel-setup.sh 使用）
ZHIPU_ZAI_API_KEY=${ZHIPU_API_KEY}
# Z.ai API Key 2 — 备用 Key，用于多账号轮询
ZHIPU_ZAI_API_KEY_2=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 小米 MiMo API Key — 从 platform.xiaomimimo.com 获取
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 小米 MiMo API Key 2 — 备用 Key，用于多账号轮询
MIMO_API_KEY_2=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# 监控告警 (Prometheus + Grafana + Alertmanager + Telegram)
# ==========================================
# 环境标识（注入 Prometheus 指标标签）
ENV=production

# Grafana 管理员账号
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Telegram Bot 告警通知（用于余额监控 + Prometheus Alertmanager）
# 1. 在 Telegram 搜索 @BotFather 创建 Bot
# 2. 获取 Bot Token（已有: @Xiao_friend_bot）
# 3. 搜索 @getidsbot 获取 Chat ID（给 bot 发消息后查 getUpdates API）
# 详见: scripts/TELEGRAM-SETUP.md
TELEGRAM_BOT_TOKEN=8812183039:AAHOB6OkhQVrSQy40ijeE_GHwoqz-FlELK8
TELEGRAM_CHAT_ID=
# 桥（AI 助手）跟进频道 Chat ID — 用于 bridge-webhook.sh + ops-notify.sh --channel bridge
# 获取方式同 TELEGRAM_CHAT_ID，给 bot 发消息后查 getUpdates API
TELEGRAM_BRIDGE_CHAT_ID=
