[Unit]
Description=ai-api-agg 支付对账服务 — Stripe + USDT 每日自动对账
Documentation=https://github.com/ai-api-agg
After=network.target

[Service]
Type=oneshot
User=openclaw
WorkingDirectory=/mnt/d/WSL/openclawWorkspace/workspace/projects/ai-api-agg
ExecStart=/bin/bash /mnt/d/WSL/openclawWorkspace/workspace/projects/ai-api-agg/scripts/reconcile-payments.sh

# 环境变量文件
EnvironmentFile=-/mnt/d/WSL/openclawWorkspace/workspace/projects/ai-api-agg/docker/.env

# 日志输出
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-api-agg-reconcile

# 安全限制
NoNewPrivileges=yes
PrivateTmp=yes

# 超时（API 请求可能较慢，设 120 秒）
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
