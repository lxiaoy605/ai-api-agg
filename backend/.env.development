# =============================================
# 后端开发环境配置
# 用于本地 Docker Compose 开发启动
# 生产配置请使用 stack/.env
# =============================================

# ---- 应用 ----
APP_JWT_SECRET=dev-jwt-secret-change-in-production
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
APP_DATABASE_PATH=/app/data/app.db
GIN_MODE=debug

# ---- NOWPayments（开发可用沙箱） ----
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# ---- USDT 钱包（开发用测试地址） ----
USDT_TRC20_WALLET=
TRON_PRO_API_KEY=
USDT_MIN_CONFIRM=12

# ---- Telegram 告警（开发可留空） ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
